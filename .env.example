# Copy this file to .env and fill in real values (never commit .env).

# Flask session signing key. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# OpenAI API key from https://platform.openai.com/api-keys
# Required even on a Gemini reply deployment: background jobs (topic classifier,
# FAQ clustering, Page auto-comment) always run on OpenAI gpt-4o-mini.
OPENAI_API_KEY=

# ─── Customer-reply LLM provider ──────────────────────────────────────────
# Leave GEMINI_API_KEY unset to keep customer replies on OpenAI
# (gpt-5.3-chat-latest). Set it to a Google AI Studio key
# (https://aistudio.google.com/apikey) to run customer replies on Google Gemini
# via its OpenAI-compatible endpoint. Default model is the highest tier,
# Gemini 3.1 Pro. GOOGLE_API_KEY is accepted as an alias.
GEMINI_API_KEY=
# Default reply model is gemini-2.5-flash: free-tier OK, thinking OFF, fast +
# full-length replies. To use the higher-quality Gemini 3.1 Pro you need BILLING
# enabled on the key (free tier = limit 0) AND these three together — Pro/3.x
# can't disable thinking, so bound it and leave token headroom for it:
#   REPLY_MODEL=gemini-3.1-pro-preview
#   GEMINI_REASONING_EFFORT=low    # bounded thinking (low|medium|high)
#   REPLY_MAX_TOKENS=2048          # room for the thinking budget + the reply
# Other optional overrides:
#   GEMINI_REASONING_EFFORT=none   # default; thinking OFF (gemini-2.5-flash only)
#   GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Facebook Page numeric ID (from the Page's About section or Graph API Explorer)
FACEBOOK_PAGE_ID=

# Long-lived Page access token. Required permissions:
#   pages_messaging, pages_messaging_subscriptions,
#   pages_read_engagement, pages_manage_posts, pages_manage_metadata
FACEBOOK_ACCESS_TOKEN=

# Facebook App Secret (from Dev Console -> App Settings -> Basic -> Show).
# Used to validate the X-Hub-Signature-256 header on incoming webhooks.
# Leave blank for dev; REQUIRED before going Live.
FACEBOOK_APP_SECRET=

# Shared secret between Facebook and this server for webhook verification.
# Generate with: python -c "import secrets; print(secrets.token_hex(16))"
VERIFY_TOKEN=

# Optional registration form link the bot sends to users
GOOGLE_FORM_URL=

# Password used to seed the default admin user on first boot.
# After login, change it via the admin UI (or delete the row and reseed).
INITIAL_ADMIN_PASSWORD=
ADMIN_EMAIL=admin@magicfinance.mn

# Emergency forgot-password recovery. Set BOTH on Render, redeploy, log in
# with the new password, then REMOVE both and redeploy again — otherwise the
# password is reset on every boot. Password must be >= 12 chars.
RESET_ADMIN_USERNAME=
RESET_ADMIN_PASSWORD=

# Public-facing contact email shown on /privacy. Falls back to ADMIN_EMAIL,
# then to info@magicfinance.mn when unset.
PRIVACY_CONTACT_EMAIL=

# Branding shown on /privacy. Each deployment overrides these to point at
# the right business; unset values fall back to Magic Financial Group.
COMPANY_LEGAL_NAME=
COMPANY_SHORT_NAME=
COMPANY_ADDRESS=
COMPANY_FACEBOOK_URL=
COMPANY_FACEBOOK_LABEL=
PRODUCT_NAME=

# Set to "true" only on a single background worker — NOT on web workers,
# or you'll double-comment on Facebook posts.
ENABLE_POLLING=false

# Opt-in: send polite Mongolian follow-up DM to users silent 4-12h.
# Only useful on a paid Render tier (Free spins the worker down).
ENABLE_NUDGE=false

# Override SQLAlchemy URI in production (Render Persistent Disk or Postgres).
# Local dev defaults to sqlite:///magic_bot.db when this is unset.
# Example: sqlite:////var/data/magic_bot.db
SQLALCHEMY_DATABASE_URI=

# Per-sender rate limit: at most RATE_LIMIT_MAX messages every
# RATE_LIMIT_WINDOW_SECONDS. Optional, defaults are 5 / 60.
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW_SECONDS=60

# ─── Multi-business reuse ─────────────────────────────────────────────────
# Override the bot's training corpus and identity per deployment so the same
# codebase can serve different businesses. When TRAINING_CONTENT is set it
# replaces pasted_content.txt; when BOT_PERSONA is set it replaces the default
# "Та Мэжик..." opening line of the system prompt. Set SEED_DEFAULTS=false
# on non-MagicBot deployments so they don't auto-seed Magic Financial Group's
# courses and FAQs (you'll add the new business's catalog via the admin UI).
TRAINING_CONTENT=
BOT_PERSONA=
SEED_DEFAULTS=true
