# Copy this file to .env and fill in real values (never commit .env).

# Flask session signing key. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# OpenAI API key from https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Facebook Page numeric ID (from the Page's About section or Graph API Explorer)
FACEBOOK_PAGE_ID=

# Long-lived Page access token. Required permissions:
#   pages_messaging, pages_messaging_subscriptions,
#   pages_read_engagement, pages_manage_posts, pages_manage_metadata
FACEBOOK_ACCESS_TOKEN=

# Facebook App Secret (from Dev Console -> App Settings -> Basic -> Show).
# Used to validate the X-Hub-Signature-256 header on incoming webhooks.
# Leave blank for dev; REQUIRED before going Live.
FACEBOOK_APP_SECRET=

# Shared secret between Facebook and this server for webhook verification.
# Generate with: python -c "import secrets; print(secrets.token_hex(16))"
VERIFY_TOKEN=

# Optional registration form link the bot sends to users
GOOGLE_FORM_URL=

# Password used to seed the default admin user on first boot.
# After login, change it via the admin UI (or delete the row and reseed).
INITIAL_ADMIN_PASSWORD=
ADMIN_EMAIL=admin@magicfinance.mn

# Public-facing contact email shown on /privacy. Falls back to ADMIN_EMAIL,
# then to info@magicfinance.mn when unset.
PRIVACY_CONTACT_EMAIL=

# Set to "true" only on a single background worker — NOT on web workers,
# or you'll double-comment on Facebook posts.
ENABLE_POLLING=false

# Opt-in: send polite Mongolian follow-up DM to users silent 4-12h.
# Only useful on a paid Render tier (Free spins the worker down).
ENABLE_NUDGE=false

# Override SQLAlchemy URI in production (Render Persistent Disk or Postgres).
# Local dev defaults to sqlite:///magic_bot.db when this is unset.
# Example: sqlite:////var/data/magic_bot.db
SQLALCHEMY_DATABASE_URI=

# Per-sender rate limit: at most RATE_LIMIT_MAX messages every
# RATE_LIMIT_WINDOW_SECONDS. Optional, defaults are 5 / 60.
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW_SECONDS=60
